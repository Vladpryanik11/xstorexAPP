# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.

# Домен API, A-запись которого указывает на IP сервера (без https://)
DOMAIN=api.example.com
# Почта для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=you@example.com

# Секреты: сгенерируйте каждый командой `openssl rand -hex 32`
POSTGRES_PASSWORD=
ADMIN_TOKEN=
GRANT_SECRET=

# Страница продления подписки (необязательно)
RENEW_URL=
LOG_LEVEL=info

# Push-уведомления (необязательно, все три или ни одного). См. deploy/README.md, раздел «Push-уведомления».
# Key ID и Team ID — 10 символов из Apple Developer, ключ — `base64 -w0 AuthKey_XXXXXXXXXX.p8`
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_BASE64=
# Bundle id приложения iStore, если меняли его в ios/project.yml
APNS_TOPIC=com.istore.app
