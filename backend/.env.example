# Порт HTTP-сервера
PORT=8080
# Публичный базовый URL (без завершающего слэша). Для OTA на устройстве нужен HTTPS с валидным сертификатом.
PUBLIC_BASE_URL=http://localhost:8080
# Токен админ-API (/admin/v1), не короче 16 символов. Пусто — админ-API отвечает 503.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
# Строка подключения PostgreSQL. Пусто — встроенный PGlite в .data/pglite
DATABASE_URL=
# Папка файлового хранилища (иконки, скриншоты, IPA)
STORAGE_DIR=./storage
# Уровень логов: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- необязательные ---
# HOST=0.0.0.0
# PGLITE_DIR=./.data/pglite
# Секрет для токенов установочных грантов (HMAC). Пусто — случайный при каждом старте.
# GRANT_SECRET=
# MAX_UPLOAD_BYTES=2147483648
# GRANT_TTL_SECONDS=1800
# SSE_PING_MS=25000
# CATALOG_JOURNAL_LIMIT=10000
# CATALOG_POLL_MS=5000
# ACTIVATE_RATE_LIMIT_MAX=10
# ACTIVATE_RATE_LIMIT_WINDOW_MS=60000
# RENEW_URL=https://istore.example/renew
# TRUST_PROXY=false
